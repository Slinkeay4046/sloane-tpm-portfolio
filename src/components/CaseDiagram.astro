---
const { project } = Astro.props as { project: string };

const diagrams: Record<string, { caption: string; steps: string[] }> = {
  'knx-saas-platform': {
    caption: 'Product delivery flow',
    steps: ['Discover', 'Prioritize', 'Build', 'Validate', 'Iterate'],
  },
  'oracle-ecr': {
    caption: 'Generic eCR implementation lifecycle',
    steps: ['Kickoff', 'Readiness', 'Approvals', 'Go-live', 'Monitor'],
  },
  'oracle-3plta-remediation': {
    caption: 'Generic dependency remediation workflow',
    steps: ['Identify risk', 'Assess impact', 'Upgrade', 'Test', 'Release validate'],
  },
};

const diagram = diagrams[project] ?? { caption: 'Delivery flow', steps: ['Plan', 'Execute', 'Validate'] };
const stepCount = diagram.steps.length;
const width = 720;
const cardWidth = stepCount === 5 ? 116 : 170;
const gap = stepCount === 5 ? 28 : 55;
const start = (width - (stepCount * cardWidth + (stepCount - 1) * gap)) / 2;
---

<figure class="case-diagram">
  <svg viewBox="0 0 720 190" role="img" aria-label={diagram.caption}>
    {diagram.steps.slice(0, -1).map((_, index) => {
      const x = start + cardWidth + index * (cardWidth + gap);
      return <line x1={x} y1="94" x2={x + gap} y2="94" />;
    })}
    {diagram.steps.map((step, index) => {
      const x = start + index * (cardWidth + gap);
      const words = step.split(' ');
      const first = words.slice(0, Math.ceil(words.length / 2)).join(' ');
      const second = words.slice(Math.ceil(words.length / 2)).join(' ');
      return <g>
        <rect x={x} y="44" width={cardWidth} height="100" rx="18" />
        <text x={x + cardWidth / 2} y={second ? 82 : 98} text-anchor="middle">{first}</text>
        {second && <text x={x + cardWidth / 2} y="108" text-anchor="middle">{second}</text>}
      </g>;
    })}
  </svg>
  <figcaption>{diagram.caption}</figcaption>
</figure>
