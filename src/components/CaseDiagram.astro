---
const { project } = Astro.props as { project: string };
const diagram = {
  'knx-saas-platform': { caption: 'Product delivery flow', steps: ['Experience design', 'Platform workflows', 'Launch + iteration'] },
  'oracle-ecr': { caption: 'Implementation delivery flow', steps: ['Kickoff + onboarding', 'Readiness + approvals', 'Soft + hard go-live'] },
  'oracle-3plta-remediation': { caption: 'Remediation delivery flow', steps: ['Risk identification', 'Upgrade + compatibility test', 'Release validation'] },
}[project] ?? { caption: 'Delivery flow', steps: ['Plan', 'Execute', 'Validate'] };
---
<figure class="case-diagram">
  <svg viewBox="0 0 720 190" role="img" aria-label={diagram.caption}>
    <line x1="175" y1="94" x2="295" y2="94" /><line x1="425" y1="94" x2="545" y2="94" />
    {diagram.steps.map((step, index) => {
      const x = [40, 290, 540][index];
      return <g><rect x={x} y="44" width="140" height="100" rx="18" /><text x={x + 70} y="84" text-anchor="middle">{step.split(' + ')[0]}</text>{step.includes(' + ') && <text x={x + 70} y="108" text-anchor="middle">+ {step.split(' + ')[1]}</text>}</g>;
    })}
  </svg>
  <figcaption>{diagram.caption}</figcaption>
</figure>
