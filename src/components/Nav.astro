---
const links = [
  { label: 'Home', href: '/' }, { label: 'Projects', href: '/projects/' },
  { label: 'Experience', href: '/experience/' }, { label: 'About', href: '/about/' },
  { label: 'Resume', href: '/resume/' }, { label: 'Contact', href: '/contact/' },
];
const active = (href: string) => Astro.url.pathname === href;
---
<nav aria-label="Primary navigation">
  <div class="menu-header"><a href="/" class="site-title"><span aria-hidden="true">✦</span> Sloane Davidson</a><button class="menu-button" aria-expanded="false" aria-controls="menu-content"><span class="sr-only">Menu</span>☰</button></div>
  <div id="menu-content" class="menu-content">
    <ul class="nav-items">{links.map(({ label, href }) => <li><a aria-current={active(href) ? 'page' : undefined} href={href}>{label}</a></li>)}</ul>
    <div class="menu-footer"><a href="https://github.com/Slinkeay4046/sloane-tpm-portfolio" rel="noopener noreferrer">GitHub</a><button class="theme" type="button" aria-label="Toggle color theme">◐</button></div>
  </div>
</nav>
<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-button')!;
  const menu = document.querySelector<HTMLElement>('#menu-content')!;
  const theme = document.querySelector<HTMLButtonElement>('.theme')!;
  const sync = () => { const wide = matchMedia('(min-width: 50em)').matches; menu.hidden = !wide; button.hidden = wide; button.setAttribute('aria-expanded', String(wide)); };
  button.addEventListener('click', () => { menu.hidden = !menu.hidden; button.setAttribute('aria-expanded', String(!menu.hidden)); });
  matchMedia('(min-width: 50em)').addEventListener('change', sync); sync();
  theme.addEventListener('click', () => { const dark = !document.documentElement.classList.contains('theme-dark'); document.documentElement.classList.toggle('theme-dark', dark); localStorage.setItem('theme', dark ? 'dark' : 'light'); });
</script>
