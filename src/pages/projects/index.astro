---
import { getCollection } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import Hero from '../../components/Hero.astro'; import ProjectCard from '../../components/ProjectCard.astro'; import ContactCTA from '../../components/ContactCTA.astro';
const projects=(await getCollection('work')).sort((a,b)=>b.data.publishDate.valueOf()-a.data.publishDate.valueOf());
---
<BaseLayout title="Projects | Sloane Keay Davidson"><div class="stack gap-20"><main class="wrapper stack gap-10"><Hero title="Projects" tagline="Three technical program case studies, each focused on the problem, my role, execution approach, outcomes, and lessons learned." align="start"/><div class="project-grid offset">{projects.map((project)=><ProjectCard {project}/>)}</div></main><ContactCTA/></div></BaseLayout>
