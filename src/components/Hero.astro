---
interface Props { title: string; tagline?: string; align?: 'start' | 'center'; }
const { title, tagline, align = 'center' } = Astro.props;
---
<div class:list={['hero', 'stack', 'gap-4', align]}><div class="stack gap-2"><h1>{title}</h1>{tagline && <p class="tagline">{tagline}</p>}</div><slot /></div>
