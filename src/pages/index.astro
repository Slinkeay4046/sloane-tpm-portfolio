---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro'; import Hero from '../components/Hero.astro'; import ProjectCard from '../components/ProjectCard.astro'; import ContactCTA from '../components/ContactCTA.astro';
const projects = (await getCollection('work')).sort((a,b)=>b.data.publishDate.valueOf()-a.data.publishDate.valueOf());
---
<BaseLayout><div class="stack gap-20 lg:gap-48"><main class="wrapper stack gap-20"><header class="home-hero"><Hero align="start" title="Sloane Keay Davidson" tagline="Technical Program Management · Product Strategy · Software Engineering"><div class="home-summary stack gap-4"><p class="home-subline">Healthcare interoperability · Federal &amp; cloud delivery · SaaS product · Atlanta / Remote</p><p class="home-intro">I lead technical programs and products from requirements to go-live. At Oracle Health, I led eCR implementation programs for about 50 healthcare clients, and at KNX Technologies I built and launched a production SaaS platform as Product Owner.</p><div class="roles"><span>Technical delivery</span><span>Product systems</span><span>Engineering fluency</span></div></div></Hero><img class="profile-photo" src="/images/sloane-davidson-profile.jpg" width="1183" height="1238" alt="Sloane Keay Davidson smiling" /></header><section class="skills"><div><h2>Technical program delivery</h2><p>Turning complex work into coordinated plans, clear dependencies, and practical execution.</p></div><div><h2>Product strategy</h2><p>Connecting user needs, technical tradeoffs, and roadmap choices to build useful products.</p></div><div><h2>Software engineering</h2><p>Bringing hands-on context across SaaS, healthcare technology, integrations, and CI/CD.</p></div></section><section class="work-section"><header><h2>Featured case studies</h2><p>Selected work across product-led SaaS development, healthcare implementation, and application security.</p></header><div class="project-grid">{projects.map((project)=><ProjectCard {project}/>)}</div><a class="text-link" href="/projects/">View all case studies →</a></section></main><ContactCTA /></div></BaseLayout>
